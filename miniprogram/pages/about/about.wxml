<view class="page about">
  <view class="profile">
    <view class="avatar">古</view>
    <view class="profile-main">
      <view class="name">{{appName}}</view>
      <view class="ver">v{{version}} · 本地阅读版</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="n">{{bookCount}}</view>
      <view class="l">收录书目</view>
    </view>
    <view class="vline"></view>
    <view class="stat-item">
      <view class="n">{{charsText}}</view>
      <view class="l">总字数</view>
    </view>
    <view class="vline"></view>
    <view class="stat-item">
      <view class="n">{{noteCount}}</view>
      <view class="l">本机笔记</view>
    </view>
  </view>

  <view class="group">
    <view class="row" bindtap="openNotes">
      <text>我的笔记</text>
      <text class="arrow">›</text>
    </view>
    <view class="row" data-type="privacy" bindtap="openDoc">
      <text>隐私政策</text>
      <text class="arrow">›</text>
    </view>
    <view class="row" data-type="terms" bindtap="openDoc">
      <text>用户协议</text>
      <text class="arrow">›</text>
    </view>
    <view class="row" data-type="disclaimer" bindtap="openDoc">
      <text>免责声明</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="group">
    <button class="row contact" open-type="contact">
      <text>联系我们</text>
      <text class="arrow">›</text>
    </button>
    <view class="row danger" bindtap="clearData">
      <text>清除本机数据</text>
    </view>
  </view>

  <view class="notice">本小程序为古籍原文阅读工具，不提供宗教活动、募捐或付费服务。</view>
  <view wx:if="{{recordNo}}" class="foot">{{recordNo}}</view>
  <view class="foot">内容来源：大正藏（公版）</view>
</view>
