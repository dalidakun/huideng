.editor {
  padding: 36rpx 36rpx 60rpx;
}

.book {
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  color: #3a3128;
}

.quote {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f1ebdf;
  border-radius: 14rpx;
}

.quote-label {
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: #a89e90;
}

.quote-text {
  margin-top: 10rpx;
  max-height: 220rpx;
  overflow: hidden;
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
  line-height: 1.8;
  color: #6f665b;
}

.field {
  position: relative;
  margin-top: 26rpx;
  padding: 24rpx;
  background: #fbf8f1;
  border: 1rpx solid rgba(122, 92, 62, 0.12);
  border-radius: 14rpx;
}

.input {
  width: 100%;
  height: 420rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #2f2a24;
}

.ph {
  color: #b3a999;
}

.counter {
  margin-top: 10rpx;
  text-align: right;
  font-size: 20rpx;
  color: #b3a999;
}

.updated {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #a89e90;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 28rpx;
}

.btn.primary {
  background: #7a5c3e;
  color: #fff;
}

.btn.ghost {
  margin-right: 20rpx;
  color: #a8552f;
  border: 1rpx solid rgba(168, 85, 47, 0.35);
}
