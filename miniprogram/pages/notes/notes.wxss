.notes {
  padding: 36rpx 36rpx 60rpx;
}

.head-title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  letter-spacing: 4rpx;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a9186;
}

.list {
  margin-top: 24rpx;
}

.note {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #fbf8f1;
  border-radius: 16rpx;
  border: 1rpx solid rgba(122, 92, 62, 0.09);
}

.note-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.note-book {
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  color: #3a3128;
}

.note-date {
  font-size: 20rpx;
  color: #a89e90;
}

.note-quote {
  margin-top: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid rgba(140, 106, 69, 0.35);
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  line-height: 1.7;
  color: #8f8578;
}

.note-text {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #2f2a24;
  white-space: pre-wrap;
}

.note-foot {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.note-pos {
  font-size: 20rpx;
  color: #b3a999;
}

.note-del {
  padding: 4rpx 18rpx;
  font-size: 21rpx;
  color: #a8552f;
  border: 1rpx solid rgba(168, 85, 47, 0.3);
  border-radius: 20rpx;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-mark {
  font-size: 64rpx;
  color: #c9b79b;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #6f665b;
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #a89e90;
}
